<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/PhotoBlog.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_sm"
    android:layout_marginBottom="@dimen/space_sm">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_image_height"
            android:background="@color/pb_surface_variant">

            <ImageView
                android:id="@+id/imageViewItem"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/pb_surface_variant"
                android:contentDescription="@string/cd_post_image"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/noImageLabelItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:drawablePadding="@dimen/space_sm"
                android:gravity="center"
                android:text="@string/no_image"
                android:textColor="@color/pb_hint"
                android:textSize="@dimen/text_preview"
                android:visibility="gone"
                app:drawableTint="@color/pb_hint"
                app:drawableTopCompat="@drawable/ic_image" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_lg"
            android:paddingTop="@dimen/space_md"
            android:paddingEnd="@dimen/space_sm"
            android:paddingBottom="@dimen/space_lg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/itemTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/pb_text"
                    android:textSize="@dimen/text_item_title"
                    android:textStyle="bold" />

                <!-- 즐겨찾기 토글 (♡/♥ 텍스트는 ImageAdapter가 설정) -->
                <TextView
                    android:id="@+id/favoriteIcon"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="@string/cd_favorite"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="♡"
                    android:textColor="@color/pb_favorite"
                    android:textSize="@dimen/text_heart" />
            </LinearLayout>

            <!-- 본문 미리보기 (2줄) -->
            <TextView
                android:id="@+id/itemText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_sm"
                android:ellipsize="end"
                android:lineSpacingExtra="2dp"
                android:maxLines="2"
                android:textColor="@color/pb_text_secondary"
                android:textSize="@dimen/text_preview" />

            <TextView
                android:id="@+id/itemDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:textColor="@color/pb_hint"
                android:textSize="@dimen/text_caption" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

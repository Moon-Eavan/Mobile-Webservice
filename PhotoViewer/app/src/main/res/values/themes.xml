<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme.
         Photo Blog 디자인(밝은 white background + blue accent)을 다크 모드에서도 동일하게 유지하기 위해
         Light 테마를 기반으로 하고 색상은 values/colors.xml의 디자인 토큰을 사용한다. -->
    <style name="Base.Theme.PhotoViewer" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/pb_primary</item>
        <item name="colorOnPrimary">@color/pb_on_primary</item>
        <item name="colorPrimaryContainer">@color/pb_primary_soft</item>
        <item name="colorOnPrimaryContainer">@color/pb_primary_dark</item>
        <item name="colorSecondaryContainer">@color/pb_primary_soft</item>
        <item name="colorOnSecondaryContainer">@color/pb_primary_dark</item>
        <item name="colorSurface">@color/pb_surface</item>
        <item name="colorOnSurface">@color/pb_text</item>
        <item name="colorOnSurfaceVariant">@color/pb_muted</item>
        <item name="colorOutline">@color/pb_border</item>
        <item name="colorError">@color/pb_error</item>
        <!-- 흰색 카드에 elevation tint(푸른 기운)가 덧씌워지지 않도록 그림자만 사용 -->
        <item name="elevationOverlayEnabled">false</item>
        <item name="android:colorBackground">@color/pb_background</item>
        <item name="android:windowBackground">@color/pb_background</item>
        <item name="android:statusBarColor">@color/pb_surface</item>
        <item name="android:navigationBarColor">@color/pb_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <style name="Theme.PhotoViewer" parent="Base.Theme.PhotoViewer" />

    <!-- ===== 공통 컴포넌트 스타일 ===== -->

    <style name="PhotoBlog.TopBar" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/toolbar_height</item>
        <item name="android:background">@color/pb_surface</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">@dimen/space_xs</item>
        <item name="android:paddingEnd">@dimen/space_xs</item>
    </style>

    <style name="PhotoBlog.IconButton" parent="">
        <item name="android:layout_width">@dimen/icon_button_size</item>
        <item name="android:layout_height">@dimen/icon_button_size</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">center</item>
        <item name="tint">@color/pb_text</item>
    </style>

    <style name="PhotoBlog.Divider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/pb_border</item>
    </style>

    <style name="PhotoBlog.FieldLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/pb_text</item>
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginBottom">@dimen/space_sm</item>
    </style>

    <style name="PhotoBlog.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radius_input</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_input</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_input</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_input</item>
        <item name="boxStrokeColor">@color/pb_input_stroke</item>
        <item name="boxBackgroundColor">@color/pb_surface</item>
        <item name="hintTextColor">@color/pb_primary</item>
    </style>

    <style name="PhotoBlog.SearchInput" parent="PhotoBlog.TextInput">
        <item name="boxCornerRadiusTopStart">28dp</item>
        <item name="boxCornerRadiusTopEnd">28dp</item>
        <item name="boxCornerRadiusBottomStart">28dp</item>
        <item name="boxCornerRadiusBottomEnd">28dp</item>
        <item name="boxBackgroundColor">@color/pb_surface_variant</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">1.5dp</item>
    </style>

    <style name="PhotoBlog.Button.Filled" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">@dimen/radius_button</item>
    </style>

    <style name="PhotoBlog.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">@dimen/radius_button</item>
    </style>

    <style name="PhotoBlog.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="strokeColor">@color/pb_border</item>
    </style>

    <style name="PhotoBlog.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/pb_muted</item>
        <item name="cornerRadius">@dimen/radius_button</item>
    </style>

    <style name="PhotoBlog.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipCornerRadius">20dp</item>
        <item name="android:textSize">14sp</item>
        <item name="chipStrokeColor">@color/pb_border</item>
        <item name="checkedIconVisible">false</item>
    </style>

    <style name="PhotoBlog.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="cardBackgroundColor">@color/pb_surface</item>
    </style>
</resources>

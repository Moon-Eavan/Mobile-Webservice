<?xml version="1.0" encoding="utf-8"?>
<!-- TextInputLayout 테두리: 포커스 시 primary, 평소에는 옅은 회색 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/pb_primary" android:state_focused="true" />
    <item android:color="@color/pb_muted" android:state_hovered="true" />
    <item android:color="@color/pb_border" android:state_enabled="false" />
    <item android:color="@color/pb_input_stroke_default" />
</selector>
